// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ValidationRule {
  id              String   @id @default(cuid())
  active          Boolean  @default(true)
  type            String   // 'Xuất toán' | 'Cảnh báo'
  xmlType         String   // XML1, XML2, ...
  field           String?
  name            String
  description     String?
  code            String
  mathExpression  String?
  checkNotNull    Boolean  @default(false)
  conditionField  String?
  conditionValue  String?
  conditionMaDichVu String?
  conditionMaDichVuValue String?
  errorMessage    String?
  isGroupCount    Boolean  @default(false)
  minCountVal     Int?
  maxCountVal     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String?
  role      String   @default("USER") // 'ADMIN', 'USER'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DraftRule {
  id              String   @id @default(cuid())
  active          Boolean  @default(true)
  type            String   // 'Xuất toán' | 'Cảnh báo'
  xmlType         String   // XML1, XML2, ...
  field           String?
  name            String
  description     String?
  code            String
  mathExpression  String?
  checkNotNull    Boolean  @default(false)
  conditionField  String?
  conditionValue  String?
  conditionMaDichVu String?
  conditionMaDichVuValue String?
  errorMessage    String?
  isGroupCount    Boolean  @default(false)
  minCountVal     Int?
  maxCountVal     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Department {
  ma_khoa         String   @id
  ten_khoa        String
  staff           Staff[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Staff {
  id              String   @id @default(cuid())
  ho_ten          String
  ma_bac_si       String   @unique
  trinh_do        String?
  chuc_danh       String?
  ma_khoa         String
  department      Department @relation(fields: [ma_khoa], references: [ma_khoa])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DuplicateRule {
  id                  String   @id @default(cuid())
  name                String
  machineCols         String[]
  serviceCol          String?
  startCol            String
  endCol              String
  ignoreMaMayMinusOne Boolean  @default(false)
  ignoreNullValues    Boolean  @default(false)
  active              Boolean  @default(true)
  serviceValues       String[]
  excludedServiceValues String[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model SpecializedRule {
  id          String   @id @default(cuid())
  name        String   // Display Name (Menu Label)
  slug        String   @unique // URL path segment (e.g., 'kiem-tra-thuoc')
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0) // For menu sorting
  
  // Rule Classification
  ruleType    String   // 'SQL', 'DUPLICATE_BED', 'MACHINE_CHECK', 'GROUP_15', etc.

  // Logic Configuration
  logicConfig Json?    // Flexible storage for rule parameters
  sqlQuery    String?  // Optional: Direct SQL for advanced users

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
